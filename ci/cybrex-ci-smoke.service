[Unit]
Description=CybrexOS CI boot qualification probe
After=multi-user.target systemd-networkd.service systemd-resolved.service nftables.service
Wants=systemd-networkd.service systemd-resolved.service nftables.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/cybrex-ci-smoke
TimeoutStartSec=150
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
