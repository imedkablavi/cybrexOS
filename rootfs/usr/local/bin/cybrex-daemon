#!/usr/bin/env python3
"""
cybrex-daemon: CybrexTech OS system-state API server.
Endpoints:
  GET  /api/state       – full JSON system state (power, security, system config)
  GET  /api/health      – liveness probe (returns {"status":"ok"})
  POST /api/power       – switch power profile  body: {"profile":"saver"|"balanced"|"performance"}
  OPTIONS *             – CORS pre-flight
"""

import http.server
import socketserver
import json
import os
import subprocess
import time
import threading
import sys
from urllib.parse import urlparse

CONFIG_DIR = "/etc/cybrex"
PORT = int(os.environ.get("CYBREX_DAEMON_PORT", "3001"))

# ---------------------------------------------------------------------------
# In-memory state
# ---------------------------------------------------------------------------
SYSTEM_STATE: dict = {
    "power": {},
    "security": {},
    "system": {},
    "lastUpdate": time.time(),
}
STATE_LOCK = threading.Lock()


# ---------------------------------------------------------------------------
# Simple flat-TOML parser (no external deps)
# ---------------------------------------------------------------------------
def parse_simple_toml(filepath: str) -> dict:
    data: dict = {}
    if not os.path.exists(filepath):
        return data

    current_section: str | None = None
    with open(filepath, "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                current_section = line[1:-1]
                data[current_section] = {}
                continue
            if "=" in line:
                key, _, val = line.partition("=")
                key = key.strip()
                val = val.strip().strip('"').strip("'")
                if val.lower() == "true":
                    val = True  # type: ignore[assignment]
                elif val.lower() == "false":
                    val = False  # type: ignore[assignment]
                if current_section is not None:
                    data[current_section][key] = val
                else:
                    data[key] = val
    return data


# ---------------------------------------------------------------------------
# Background state-refresh thread
# ---------------------------------------------------------------------------
def _update_state_loop() -> None:
    while True:
        try:
            new_power    = parse_simple_toml(os.path.join(CONFIG_DIR, "power.toml"))
            new_security = parse_simple_toml(os.path.join(CONFIG_DIR, "security.toml"))
            new_system   = parse_simple_toml(os.path.join(CONFIG_DIR, "main.toml"))
            with STATE_LOCK:
                SYSTEM_STATE["power"]      = new_power
                SYSTEM_STATE["security"]   = new_security
                SYSTEM_STATE["system"]     = new_system
                SYSTEM_STATE["lastUpdate"] = time.time()
        except Exception as exc:  # noqa: BLE001
            print(f"[cybrex-daemon] state refresh error: {exc}", file=sys.stderr)
        time.sleep(5)


# ---------------------------------------------------------------------------
# HTTP request handler
# ---------------------------------------------------------------------------
CORS_HEADERS = {
    "Access-Control-Allow-Origin":  "*",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, X-Requested-With",
}

VALID_PROFILES = {"saver", "balanced", "performance"}


class APIHandler(http.server.BaseHTTPRequestHandler):

    def _send_json(self, code: int, body: dict) -> None:
        payload = json.dumps(body).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        for k, v in CORS_HEADERS.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(payload)

    def _read_json_body(self) -> dict:
        length = int(self.headers.get("Content-Length", 0))
        if length == 0:
            return {}
        raw = self.rfile.read(length)
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return {}

    # ---- GET ---------------------------------------------------------------

    def do_GET(self) -> None:
        path = urlparse(self.path).path
        if path == "/api/state":
            with STATE_LOCK:
                snapshot = dict(SYSTEM_STATE)
            self._send_json(200, snapshot)

        elif path == "/api/health":
            self._send_json(200, {"status": "ok", "ts": time.time()})

        else:
            self._send_json(404, {"error": "not found"})

    # ---- POST --------------------------------------------------------------

    def do_POST(self) -> None:
        path = urlparse(self.path).path

        if path == "/api/power":
            body = self._read_json_body()
            profile = body.get("profile", "")
            if profile not in VALID_PROFILES:
                self._send_json(400, {
                    "error": f"invalid profile; use one of {sorted(VALID_PROFILES)}"
                })
                return
            try:
                subprocess.run(
                    ["/usr/local/bin/cybrex-ctl", "power", profile],
                    check=True,
                    timeout=10,
                )
                self._send_json(200, {"ok": True, "profile": profile})
            except subprocess.CalledProcessError as exc:
                self._send_json(500, {"error": f"cybrex-ctl exited {exc.returncode}"})
            except subprocess.TimeoutExpired:
                self._send_json(500, {"error": "cybrex-ctl timed out"})
        else:
            self._send_json(404, {"error": "not found"})

    # ---- OPTIONS (CORS pre-flight) -----------------------------------------

    def do_OPTIONS(self) -> None:
        self.send_response(200)
        for k, v in CORS_HEADERS.items():
            self.send_header(k, v)
        self.end_headers()

    def log_message(self, fmt, *args) -> None:  # silence default access log
        pass


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main() -> None:
    t = threading.Thread(target=_update_state_loop, daemon=True)
    t.start()

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), APIHandler) as httpd:
        print(f"[cybrex-daemon] listening on port {PORT}", flush=True)
        httpd.serve_forever()


if __name__ == "__main__":
    main()
