#!/bin/bash
# cybrex-secureboot: inspection-only helper for the current alpha.
# Firmware key creation/enrollment is intentionally not automated until the
# documented Secure Boot design has passed OVMF and bare-metal qualification.
set -Eeuo pipefail

cmd="${1:-status}"

usage() {
    cat <<'EOF'
Usage: cybrex-secureboot [status|verify-files|enroll]

  status        Report the firmware Secure Boot state when tooling is available.
  verify-files  Inspect signatures on EFI/kernel artifacts when sbverify exists.
  enroll        Refused in this alpha; follow docs/SECURE_BOOT.md design first.
EOF
}

case "$cmd" in
    status)
        if command -v mokutil >/dev/null 2>&1; then
            mokutil --sb-state
        elif [[ -d /sys/firmware/efi/efivars ]]; then
            echo "UEFI runtime variables are available; install mokutil for a clearer Secure Boot state."
        else
            echo "UEFI runtime variables are not available in this boot environment."
        fi
        ;;
    verify-files)
        if ! command -v sbverify >/dev/null 2>&1; then
            echo "sbverify is not installed; no signature claim can be made." >&2
            exit 2
        fi
        found=0
        while IFS= read -r file; do
            found=1
            echo "== $file =="
            sbverify --list "$file" || true
        done < <(find /boot/efi/EFI /boot -maxdepth 4 -type f \( -iname '*.efi' -o -name 'vmlinuz-*' \) 2>/dev/null | sort -u)
        [[ "$found" == "1" ]] || { echo "No EFI/kernel files found to inspect." >&2; exit 2; }
        ;;
    enroll)
        echo "Secure Boot key enrollment is intentionally disabled in this alpha." >&2
        echo "See docs/SECURE_BOOT.md in the source repository." >&2
        exit 2
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
