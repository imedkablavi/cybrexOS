#!/bin/bash
# cybrex-dev-setup: Install Developer, Security, Mobile & Gaming stacks
# This script is intended to be run by the user after first boot.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: cybrex-dev-setup [profile]

Profiles:
  web      Install web stack
  backend  Install backend stack
  mobile   Install mobile development stack
  sec      Install security stack
  gaming   Install gaming stack
  full     Install all supported stacks (default)

Options:
  -h, --help  Show this help text

Examples:
  sudo cybrex-dev-setup
  sudo cybrex-dev-setup gaming
  sudo cybrex-dev-setup mobile
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if [[ $# -gt 1 ]]; then
    echo "[ERROR] Too many arguments." >&2
    usage
    exit 1
fi

if [[ "${EUID}" -ne 0 ]]; then
    echo "[ERROR] This script must be run as root (use sudo)." >&2
    exit 1
fi

PROFILE="${1:-full}"

install_packages() {
    local available=()
    local pkg
    for pkg in "$@"; do
        if apt-cache show "${pkg}" >/dev/null 2>&1; then
            available+=("${pkg}")
        else
            echo "[WARN] Package '${pkg}' is not available in current repositories. Skipping."
        fi
    done

    if [[ "${#available[@]}" -gt 0 ]]; then
        apt install -y "${available[@]}"
    fi
}

install_web() {
    echo "[*] Installing Web Stack..."
    install_packages nodejs npm nginx
}

install_backend() {
    echo "[*] Installing Backend Stack..."
    install_packages golang-go python3-full python3-pip postgresql-client docker.io docker-compose
}

install_mobile() {
    echo "[*] Installing Mobile Stack..."
    install_packages android-sdk adb fastboot openjdk-17-jdk gradle
}

install_sec() {
    echo "[*] Installing Security Stack..."
    install_packages nmap wireshark tcpdump whois jq sqlmap
}

install_gaming() {
    echo "[*] Installing Gaming Stack..."
    install_packages steam-installer lutris gamemode mangohud vulkan-tools mesa-vulkan-drivers
}

install_base() {
    echo "[*] Installing Base Dev Tools..."
    install_packages git curl wget build-essential vim htop tmux unzip ca-certificates
}

case "${PROFILE}" in
    web|backend|mobile|sec|gaming|full) ;;
    *)
        echo "[ERROR] Unknown profile: ${PROFILE}" >&2
        usage
        exit 1
        ;;
esac

echo "--- CybrexTech OS: Dev Setup (${PROFILE}) ---"
apt update

install_base

case "${PROFILE}" in
    web)
        install_web
        ;;
    backend)
        install_backend
        ;;
    mobile)
        install_mobile
        ;;
    sec)
        install_sec
        ;;
    gaming)
        install_gaming
        ;;
    full)
        install_web
        install_backend
        install_mobile
        install_sec
        install_gaming
        ;;
esac

echo "[SUCCESS] Environment '${PROFILE}' Ready."
